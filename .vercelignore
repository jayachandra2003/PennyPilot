# Vercel Deployment Ignore Rules
# Keeps serverless lambda bundle lean (<35MB) and protects private dev artifacts

# SQLite Databases & Backups
*.db
*.db-shm
*.db-wal
backups/
penny_pilot.db*
demo_presentation.db*
backend/*.db*

# Dev, Test & Audit Folders
tests/
backend/tests/
scratch/
screenshots/
artifacts/
docs/
.pytest_cache/
__pycache__/
*.pyc

# Local Environment & Secrets
.env
.env.*
!.env.production.example

# Local Startup & Shell Scripts
*.bat
*.ps1

# Static Visual Assets not used at runtime
*.png
*.jpg
*.jpeg
*.pdf
!frontend/public/**
!frontend/src/assets/**
