# ==============================================================================
# PENNYPILOT PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
#
# IMPORTANT:
# - Do NOT commit actual secrets or production keys to version control.
# - Enter these values directly into the Vercel Project Dashboard:
#   Project Settings -> Environment Variables -> Production & Preview.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=PennyPilot
VERSION=0.1.0
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# Generate a fresh 64-character hex key: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=generate_a_secure_64_char_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE (NEON SERVERLESS POSTGRESQL)
# Obtain from Neon Dashboard -> Project -> Connection Details.
# CRITICAL: Always use the POOLED connection string (port 5432 or 6543 with -pooler)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://your_user:your_password@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 4. URLS, HOSTS & CORS
# In a unified Vercel deployment, Frontend and Backend share the SAME origin URL.
# ------------------------------------------------------------------------------
FRONTEND_URL=https://your-pennypilot-project.vercel.app
FRONTEND_BASE_URL=https://your-pennypilot-project.vercel.app
BACKEND_BASE_URL=https://your-pennypilot-project.vercel.app
ALLOWED_ORIGINS=https://your-pennypilot-project.vercel.app

# ------------------------------------------------------------------------------
# 5. COOKIES & SESSIONS
# ------------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_DAYS=14

# ------------------------------------------------------------------------------
# 6. BREVO SMTP (TRANSACTIONAL EMAIL VERIFICATION & PASSWORD RESET)
# Obtain from Brevo Dashboard -> SMTP & API -> SMTP tab.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_account_email@example.com
SMTP_PASSWORD=your_brevo_generated_smtp_key_here
SMTP_FROM_EMAIL=your_verified_sender_email@example.com
SMTP_FROM_NAME=PennyPilot
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 / OPENID CONNECT
# Obtain from Google Cloud Console -> APIs & Services -> Credentials.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-pennypilot-project.vercel.app/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. AI ENGINE CONFIGURATION (HOSTED FREE TIER)
# Obtain free API key from Google AI Studio (https://aistudio.google.com).
# Provides hosted Gemini 3.8 Flash for vision OCR and Copilot narration.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 9. PERSISTENT OBJECT STORAGE (CLOUDFLARE R2)
# Generous free tier ($0/mo, 10 GB storage, 0 egress fees).
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
# ------------------------------------------------------------------------------
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=pennypilot-storage
# R2_ENDPOINT_URL is optional (auto-constructed if omitted)
# R2_ENDPOINT_URL=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 10. LOCAL SCRATCH FILE STORAGE (FALLBACK)
# On Vercel, the filesystem is read-only except /tmp.
# ------------------------------------------------------------------------------
AVATAR_UPLOAD_DIR=/tmp/uploads/avatars
RECEIPT_UPLOAD_DIR=/tmp/uploads/receipts

# ------------------------------------------------------------------------------
# 11. FRONTEND VITE VARIABLES (PUBLIC)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=
