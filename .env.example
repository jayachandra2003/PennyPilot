# PennyPilot Environment Variables Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to source control!

# Environment: "development" | "production" | "testing"
ENVIRONMENT=development
DEBUG=true

# Security & Auth
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-required
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Local SQLite (default):
DATABASE_URL=sqlite:///./penny_pilot.db
# Cloud PostgreSQL (Neon / Render):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/pennypilot?sslmode=require

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# URLs for Development vs Production
# In local development:
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
# In production (example):
# FRONTEND_URL=https://pennypilot.in
# BACKEND_BASE_URL=https://api.pennypilot.in

# Cookie Security (Auto-promoted to true in production or over HTTPS)
COOKIE_SECURE=false

# AI Configuration (3-Tier Fallback Chain - 100% Zero-Budget)
# Tier 1 (Free Cloud AI - Optional):
GEMINI_API_KEY=
GROQ_API_KEY=

# Tier 2 (Local Ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Default Localization
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Brevo SMTP Configuration (Email Verification & Password Reset)
# Obtain your SMTP key from: Brevo Dashboard -> Transactional -> Settings -> Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login@example.com
SMTP_PASSWORD=your_brevo_smtp_master_key_here
SMTP_FROM_EMAIL=jayachandravennam.jc@gmail.com
SMTP_FROM_NAME=PennyPilot
SMTP_USE_TLS=true

# Google OAuth 2.0 / OpenID Connect (Optional)
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# In development:
#   Authorized JavaScript origin: http://localhost:5173
#   Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
# In production (example):
#   Authorized JavaScript origin: https://pennypilot.in
#   Authorized redirect URI: https://api.pennypilot.in/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend Vite Build Variables (Optional - defaults to relative /api/v1)
# VITE_API_BASE_URL=/api/v1
# VITE_AUTH_BASE_URL=http://localhost:8000
